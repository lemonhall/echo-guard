[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/echo_guard_main.gd" id="1"]

[node name="Main" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="UI" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="UI"]
text = "echo-guard (Godot Step 6)"

[node name="Row1" type="HBoxContainer" parent="UI"]
theme_override_constants/separation = 8

[node name="StartBtn" type="Button" parent="UI/Row1"]
text = "Start (R)"

[node name="StopBtn" type="Button" parent="UI/Row1"]
text = "Stop + Export (R)"

[node name="OpenOutBtn" type="Button" parent="UI/Row1"]
text = "Open Output Folder"

[node name="ProcessBtn" type="Button" parent="UI/Row1"]
text = "Process Last Capture"

[node name="ReloadBtn" type="Button" parent="UI/Row1"]
text = "Reload Segments"

[node name="Status" type="Label" parent="UI"]
text = "Status: idle"
autowrap_mode = 3

[node name="Segments" type="ItemList" parent="UI"]
size_flags_vertical = 3
allow_reselect = true

[node name="Row2" type="HBoxContainer" parent="UI"]
theme_override_constants/separation = 8

[node name="PlayBtn" type="Button" parent="UI/Row2"]
text = "Play Selected"

[node name="StopPlayBtn" type="Button" parent="UI/Row2"]
text = "Stop Playback"

[node name="Row3" type="HBoxContainer" parent="UI"]
theme_override_constants/separation = 8

[node name="MonitorMicChk" type="CheckBox" parent="UI/Row3"]
text = "Monitor mic (hear yourself)"

[node name="SegmentPlayer" type="AudioStreamPlayer" parent="."]
bus = "Master"
